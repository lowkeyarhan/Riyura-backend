# ─── Riyura Backend — Environment Variables Template ──────────────────────────
# Copy this file to .env and fill in real values.
# The .env file is gitignored — NEVER commit secrets.
#
# In production (AWS ECS / Oracle OCI), inject these as platform env vars
# or via a secrets manager — do NOT bind-mount .env into the prod container.
# ──────────────────────────────────────────────────────────────────────────────

# ── App Encryption ─────────────────────────────────────────────────────────────
ENCRYPTION_KEY=<your-64-char-hex-key>

# ── Supabase ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
SUPABASE_JWT_SECRET=<supabase-jwt-secret>
SUPABASE_ISSUER_URI=https://<project-ref>.supabase.co/auth/v1

# ── Database (Supabase Postgres / external) ────────────────────────────────────
DB_URL=jdbc:postgresql://<host>:<port>/postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<db-password>

# ── TMDB ───────────────────────────────────────────────────────────────────────
TMDB_API_KEY=<tmdb-api-key>
TMDB_API_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# ── Redis ──────────────────────────────────────────────────────────────────────
# Dev (local / docker-compose): use "redis" (service name) as REDIS_HOST
# Docker Compose overrides this automatically — set localhost only for bare-metal dev
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── CORS / Frontend ────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Observability (optional — enable when running observability stack) ─────────
LOKI_ENABLED=false
LOKI_URL=http://loki:3100/loki/api/v1/push
GRAFANA_ADMIN_PASSWORD=admin
